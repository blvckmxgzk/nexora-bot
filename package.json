{
  "name": "nexora-bot",
  "version": "1.0.0",
  "description": "NEXORA All-in-One Discord Community Bot",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "deploy": "npm run build && node dist/deploy-commands.js",
    "seed:items": "npm run build && node dist/seed-items.js",
    "test:marketplace": "npm run build && node scripts/marketplace-smoke-test.mjs",
    "auto-push": "node scripts/auto-push.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "discord.js": "^14.24.2",
    "dotenv": "^17.2.2",
    "fastify": "^5.12.3",
    "fastify-plugin": "^6.0.0",
    "fastify-raw-body": "^6.0.1",
    "mongoose": "^8.18.0",
    "mongoosh": "^0.0.7",
    "mongosh": "^2.10.0",
    "pino": "^9.9.4",
    "sharp": "^0.35.4",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "chokidar": "^5.0.0",
    "mongodb-memory-server": "^11.2.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
